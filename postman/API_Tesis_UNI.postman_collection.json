{
  "info": {"name":"API Tesis UNI - Laboratorio 8 y 9","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://localhost:5000"},{"key":"token","value":""},{"key":"lineaId","value":""},{"key":"estudianteId","value":""}],
  "item": [
