      {"name":"Registrar usuario","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Usuario Laboratorio\",\n  \"email\": \"laboratorio@uni.edu.ni\",\n  \"password\": \"ClaveSegura123\"\n}"},"url":"{{baseUrl}}/api/auth/register"}},
      {"name":"Login","event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"laboratorio@uni.edu.ni\",\n  \"password\": \"ClaveSegura123\"\n}"},"url":"{{baseUrl}}/api/auth/login"}},
