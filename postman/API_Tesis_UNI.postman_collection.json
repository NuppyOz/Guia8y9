      {"name":"Listar lineas","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/lineas"}},
      {"name":"Actualizar linea","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Inteligencia Artificial Aplicada\",\n  \"activa\": true\n}"},"url":"{{baseUrl}}/api/lineas/{{lineaId}}"}},
      {"name":"Eliminar linea","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/lineas/{{lineaId}}"}}
