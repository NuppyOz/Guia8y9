    {"name":"Estudiantes","item":[
      {"name":"Crear estudiante","event":[{"listen":"test","script":{"exec":["if (pm.response.code === 201) { pm.collectionVariables.set('estudianteId', pm.response.json()._id); }"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"carnet\": \"2026-0001U\",\n  \"nombre\": \"Estudiante de prueba\",\n  \"carrera\": \"Ingeniería en Sistemas\",\n  \"lineaInvestigacion\": \"{{lineaId}}\"\n}"},"url":"{{baseUrl}}/api/estudiantes"}},
      {"name":"Listar estudiantes","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/estudiantes"}},
