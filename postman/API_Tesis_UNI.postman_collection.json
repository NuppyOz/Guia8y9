      {"name":"Actualizar estudiante","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"raw","raw":"{\n  \"nombre\": \"Estudiante actualizado\"\n}"},"url":"{{baseUrl}}/api/estudiantes/{{estudianteId}}"}},
      {"name":"Eliminar estudiante","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/estudiantes/{{estudianteId}}"}}
